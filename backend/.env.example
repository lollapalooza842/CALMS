# Copy this file to .env and fill it in. Never commit .env.

# Supabase: Project Settings > Database > Connection string > URI (use the "Session pooler" one).
# It looks like: postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Any long random string. It signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

PORT=3000

# Minutes without activity before a session ends (SRS FR-114).
SESSION_IDLE_MINUTES=15

# For development only: a fixed 6-digit code that passes the second factor, so the group can
# sign in without an authenticator app. Leave it empty in production.
DEV_MFA_CODE=246810

# Email (optional). Without these, email shows as "Not connected" on the System page.
# For Gmail: turn on 2-Step Verification for the account, then make an app password at
# https://myaccount.google.com/apppasswords and paste it below (the 16 letters; spaces are fine).
# Use a Gmail account made for CALMS, not your personal one.
SMTP_USER=
SMTP_PASS=
# Only change these for a mail server other than Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# The address of CALMS that emails link to, once it is hosted (for example https://calms.example.com):
# PUBLIC_URL=

# Kuwa, the guide on the public website (optional). Without a key he still answers the common questions himself.
# Get a free key at https://aistudio.google.com/apikey and paste it here (and in Render > Environment). Never share it.
GEMINI_API_KEY=
# KUWA_MODEL=gemini-flash-latest
