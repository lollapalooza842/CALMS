{
  "name": "calms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CALMS back end: Express API over a Supabase (PostgreSQL) database. Also serves the front end.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "db:seed": "node scripts/db-seed.js",
    "db:reset": "node scripts/demo-reset.js",
    "test": "node scripts/smoke-test.js",
    "unlock": "node scripts/unlock.js",
    "audit:check": "node scripts/audit-check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5"
  }
}
